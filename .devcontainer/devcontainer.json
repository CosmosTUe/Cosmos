{
	"name": "Cosmos Dev Container",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspace",

	// Automatically installing useful VS Code extensions
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"batisteo.vscode-django"
			]
		}
	},

	// Run setup script after the container is created
	"postCreateCommand": "chmod +x .devcontainer/setup.sh && bash .devcontainer/setup.sh",

	"forwardPorts": [8000],
	"remoteUser": "root"
}