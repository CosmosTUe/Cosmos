{
	"name": "Cosmos Dev Container",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspace",

	// Adding features to the dev container
	"features": {
		"ghcr.io/devcontainers/features/python:1": {
			"version": "3.8",
			"installTools": true
		},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		},
		"ghcr.io/devcontainers-extra/features/pipenv:2": {},

		"ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
			"packages": "libpq-dev,postgresql-client,build-essential,git"
		},
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
			"configureZshAsDefaultShell": true
		}
	},

	"containerEnv": {
		"PIPENV_VENV_IN_PROJECT": "1"
	},

	// Automatically installing useful VS Code extensions
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"batisteo.vscode-django",
				"ms-python.black-formatter",
				"ms-python.isort",
				"ms-python.flake8"
			],
			"settings": {
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
				"files.trimTrailingWhitespace": true,
				"python.analysis.extraPaths": ["./apps"],
				"[python]": {
					"editor.formatOnSave": true,
					"editor.defaultFormatter": "ms-python.black-formatter",
					"editor.codeActionsOnSave": {
						"source.organizeImports": "explicit"
					}
				},

				"black-formatter.importStrategy": "fromEnvironment",

				"black-formatter.args": [
				],
				"isort.args": [
					"--profile",
					"black"
				],
				"flake8.args": [
					"--ignore=E203,E501,W503"
				]
			}
		}
	},
	// Run setup script after the container is created
	"postCreateCommand": "bash .devcontainer/setup.sh",

	"forwardPorts": [8000],
	"remoteUser": "vscode"
}